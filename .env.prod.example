# Copy to ".env" on the VPS (next to docker-compose.prod.yml) and fill in.
# docker compose reads this file automatically.

# Postgres password (pick a long random one)
POSTGRES_PASSWORD=change-me-strong-password

# JWT signing secret — generate with: openssl rand -hex 32
JWT_SECRET=change-me-random-hex

# Public address of the server (used to build upload URLs).
# Start with the IP, switch to https://your-domain once you add TLS.
PUBLIC_URL=http://YOUR_SERVER_IP

# SMTP for login codes
SMTP_HOST=smtp.yandex.ru
SMTP_PORT=587
SMTP_FROM=you@example.com
SMTP_PASS=your-smtp-app-password
