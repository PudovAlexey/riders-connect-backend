# Serves the built SPA and reverse-proxies the API + WebSocket to the backend
# container (`app`). Caddy auto-provisions and renews a Let's Encrypt cert for
# the domain below and redirects http->https. Single origin -> no CORS needed.
motocade.ru {
	encode zstd gzip
	root * /srv

	request_body {
		max_size 25MB          # allow media uploads
	}

	# API + uploads + WebSocket -> Go backend (boundary-matched like the old nginx
	# regex: exact path or sub-paths only, never /authxyz).
	@backend path /auth /auth/* /profile /profile/* /geo /geo/* /points /points/* \
		/routes /routes/* /chat /chat/* /events /events/* /contacts /contacts/* /garage /garage/* \
		/push /push/* /media /media/* /uploads /uploads/* /health /health/* /ws /ws/*
	handle @backend {
		reverse_proxy app:8080   # Caddy upgrades WebSocket connections automatically
	}

	# SPA fallback — every other path returns index.html
	handle {
		try_files {path} /index.html
		file_server
	}
}
