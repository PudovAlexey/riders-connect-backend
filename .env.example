PORT=8080
DATABASE_URL=postgres://postgres:postgres@localhost:5432/riders_connect?sslmode=disable
JWT_SECRET=change-me-in-production
APP_ENV=development

# SMTP (optional, prints to stdout in development)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_FROM=
SMTP_PASS=

# File uploads
UPLOAD_DIR=./uploads
UPLOAD_BASE_URL=http://localhost:8080

# CORS: comma-separated allowed browser origins, or "*" for any.
# In production set this to your frontend URL, e.g. https://riders.example.com
CORS_ORIGINS=*
